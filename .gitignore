vendor
auth.json
composer.lock

# IDE
.phpstorm.meta.php
_ide_helper_models.php
_ide_helper.php
_ide_macros.php
.idea/*
!/.idea/codeStyles

# JS
node_modules
npm-debug.log
yarn-error.log

# Docs site (VitePress) — build output and deps, never the sources.
docs/node_modules/
docs/.vitepress/cache/
docs/.vitepress/dist/

# MacOS
.DS_STORE

# Environment
.env
.env.*
!.env.example
!.env.ci
logs
.phpactor.json

# Release notes — picked up by CI on tag and promoted into CHANGELOG.md.
RELEASE_NOTES*.md
.claude/scheduled_tasks.lock

# Skill mirrors regenerated by `composer sync-ai` (package-boost:sync).
# Some entries are symlinks into vendor/, which would dangle on GitHub
# web (no vendor/) and in fresh clones before composer install.
# Source of truth: .ai/skills/ + vendor/<pkg>/resources/boost/skills/.
.github/skills/
.claude/skills/
.agents/skills/
# >>> boost (managed) >>>
# Generated by boost-core. Edit .ai/ instead.
.agents/skills/
.boost/
.claude/commands/
.claude/skills/
.config/boost/
.github/prompts/
# <<< boost (managed) <<<

# Added by repo-init (canonical shared .gitignore lines).
storage/logs
/build
/.fleet
/.vscode
/.cursor
phpstan.neon
/coverage
/internal
/autoresearch
